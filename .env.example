# === Core application ===
APP_ENV=development
APP_SECRET=replace-with-a-long-random-secret
APP_BASE_URL=http://localhost:8000
AUTH_MODE=dev
STORAGE_BACKEND=local
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/docuquery
REDIS_URL=redis://localhost:6379/0
LOCAL_STORAGE_ROOT=uploads

# Local dev principal. Must match db/local_bootstrap.sql.
DEV_USER_ID=00000000-0000-0000-0000-000000000001
DEV_USER_EMAIL=dev@docuquery.local

# === AI provider modes ===
# Recommended default: fully local semantic retrieval, no generative LLM.
APP_MODE=search_only
EMBEDDING_PROVIDER=local
CHAT_PROVIDER=disabled
AI_MODE=gemini

# Local multilingual E5 embeddings (768 dimensions, compatible with current vector schema).
LOCAL_EMBED_MODEL=intfloat/multilingual-e5-base
LOCAL_EMBED_DEVICE=cpu
LOCAL_EMBED_QUERY_PREFIX=query: 
LOCAL_EMBED_PASSAGE_PREFIX=passage: 
EMBEDDING_DIMENSION=768

# Optional local LLM. Set APP_MODE=local_llm and CHAT_PROVIDER=local.
# Works with OpenAI-compatible Ollama/llama.cpp/vLLM endpoints.
LOCAL_LLM_BASE_URL=http://host.docker.internal:11434/v1
LOCAL_LLM_API_KEY=ollama
LOCAL_LLM_MODEL=qwen2.5:7b
LOCAL_LLM_TIMEOUT_SECONDS=120

# === Production Supabase mode ===
# AUTH_MODE=supabase
# STORAGE_BACKEND=supabase
# SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# SUPABASE_SECRET_KEY=sb_secret_...
# SUPABASE_JWKS_URL=https://YOUR_PROJECT.supabase.co/auth/v1/.well-known/jwks.json
# STORAGE_BUCKET=documents

# === Optional Gemini cloud providers ===
# For cloud embeddings: EMBEDDING_PROVIDER=gemini
# For cloud answer generation: APP_MODE=cloud_llm and CHAT_PROVIDER=gemini
# GEMINI_API_KEY=managed-server-key-if-using-DocuQuery-managed-AI
GEMINI_CHAT_MODEL=gemini-2.5-flash
GEMINI_EMBED_MODEL=gemini-embedding-001

# Generate with: python scripts/generate_fernet_key.py
CREDENTIAL_ENCRYPTION_KEY=

MAX_UPLOAD_MB=20
RATE_LIMIT_ASK=20/minute
MONTHLY_QUESTION_LIMIT_DEFAULT=1000
STORAGE_LIMIT_BYTES_DEFAULT=2147483648

# Optional scanned-PDF OCR. Requires Tesseract installed with eng/nep language packs.
OCR_ENABLED=false
TESSERACT_CMD=

# Optional ClamAV upload scanning.
MALWARE_SCAN_ENABLED=false
CLAMAV_HOST=clamav
CLAMAV_PORT=3310
