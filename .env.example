# === Local end-to-end mode ===
APP_ENV=development
APP_SECRET=replace-with-a-long-random-secret
APP_BASE_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:8000,http://localhost:8080,http://localhost:3000
AUTH_MODE=dev
AI_MODE=mock
STORAGE_BACKEND=local
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/docuquery
REDIS_URL=redis://localhost:6379/0
LOCAL_STORAGE_ROOT=uploads

# Local dev principal. Must match db/local_bootstrap.sql.
DEV_USER_ID=00000000-0000-0000-0000-000000000001
DEV_USER_EMAIL=dev@docuquery.local

# === Production Supabase mode ===
# APP_ENV=production
# APP_BASE_URL=https://api.yourdomain.com
# CORS_ORIGINS=https://app.yourdomain.com
# AUTH_MODE=supabase
# STORAGE_BACKEND=supabase
# DATABASE_URL=postgresql+asyncpg://postgres.PROJECT_REF:URL_ENCODED_PASSWORD@SUPAVISOR_SESSION_HOST:5432/postgres
# REDIS_URL is injected by Render from the Key Value service.
# SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# SUPABASE_SECRET_KEY=sb_secret_...
# SUPABASE_JWKS_URL=https://YOUR_PROJECT.supabase.co/auth/v1/.well-known/jwks.json
# STORAGE_BUCKET=docuquery-documents

# === Production Gemini mode ===
# AI_MODE=gemini
# GEMINI_API_KEY=managed-server-key-if-using-DocuQuery-managed-AI
GEMINI_CHAT_MODEL=gemini-3.6-flash
GEMINI_EMBED_MODEL=gemini-embedding-2
EMBEDDING_DIMENSION=768
RETRIEVAL_MIN_SCORE=0.35

# Generate with: python scripts/generate_fernet_key.py
CREDENTIAL_ENCRYPTION_KEY=

MAX_UPLOAD_MB=20
RATE_LIMIT_ASK=20/minute
MONTHLY_QUESTION_LIMIT_DEFAULT=1000
STORAGE_LIMIT_BYTES_DEFAULT=2147483648

# Optional scanned-PDF OCR. Requires Tesseract installed with eng/nep language packs.
OCR_ENABLED=false
TESSERACT_CMD=

# Optional ClamAV upload scanning.
MALWARE_SCAN_ENABLED=false
CLAMAV_HOST=clamav
CLAMAV_PORT=3310
